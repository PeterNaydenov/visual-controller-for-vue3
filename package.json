{
  "name": "@peter.naydenov/visual-controller-for-vue3",
  "description": "Use it when single javascript application should control multiple vue3 apps.",
  "version": "3.0.0",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./src/main.js",
  "types": "./dist/main.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/visual-controller-for-vue3.esm.mjs",
      "require": "./dist/visual-controller-for-vue3.cjs",
      "default": "./dist/visual-controller-for-vue3.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run types",
    "preview": "vite preview",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "types": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/visual-controller-for-vue3.git"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "ask-for-promise": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.41"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
